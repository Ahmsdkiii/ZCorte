# ==============================================================================
# ZCorté — Environment Variables Example
# Salin file ini menjadi `.env` untuk development lokal: cp .env.example .env
# JANGAN PERNAH meng-commit file `.env` yang berisi secret ke repository.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (R0 Wajib)
# Default cocok langsung dengan `docker-compose.yml` (`docker compose up -d db db-test`)
# ------------------------------------------------------------------------------
# [SERVER-ONLY] PostgreSQL untuk development lokal
DATABASE_URL="postgresql://zcorte:zcorte_dev_password@localhost:5432/zcorte_dev?schema=public"

# [SERVER-ONLY] PostgreSQL terpisah untuk integration test (port 5433)
DATABASE_URL_TEST="postgresql://zcorte:zcorte_test_password@localhost:5433/zcorte_test?schema=public"

# ------------------------------------------------------------------------------
# 2. Seed Demo (Development Only)
# ------------------------------------------------------------------------------
# [SERVER-ONLY] Wajib diisi untuk menjalankan `pnpm db:seed`; jangan commit nilainya.
SEED_OWNER_PASSWORD=""
SEED_CUSTOMER_PASSWORD=""

# ------------------------------------------------------------------------------
# 3. Aplikasi & Autentikasi (R0 Wajib)
# ------------------------------------------------------------------------------
# [PUBLIC] URL dasar storefront untuk metadata, sitemap, & canonical URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# [SERVER-ONLY] Secret penandatanganan sesi Auth.js (generate: `openssl rand -base64 32`)
AUTH_SECRET="replace-with-openssl-rand-base64-32"

# [SERVER-ONLY] Prefix nomor pesanan yang dibuat atomik di server
ORDER_NUMBER_PREFIX="ZCT"

# ------------------------------------------------------------------------------
# 3. Mode Adapter R0 (Default deterministik tanpa layanan eksternal)
# ------------------------------------------------------------------------------
# [SERVER-ONLY] "simulated" (R0) | "sandbox" (R1)
PAYMENT_MODE="simulated"

# [SERVER-ONLY] "scripted" (R0) | "ai" (R1)
ASSISTANT_MODE="scripted"

# [SERVER-ONLY] "simulator" (R0) | "bot" (R1)
TELEGRAM_MODE="simulator"

# [SERVER-ONLY] "local" (R0) | "cloudinary" (R1)
STORAGE_MODE="local"

# ------------------------------------------------------------------------------
# 4. Integrasi R1 (Opsional — kosongkan pada R0, isi hanya saat evaluasi R1)
# ------------------------------------------------------------------------------
# [SERVER-ONLY] Token proteksi endpoint `/api/cron/*`
CRON_SECRET=""

# [SERVER-ONLY] Konfigurasi provider AI R1
AI_PROVIDER=""
AI_MODEL=""
AI_API_KEY=""
AI_DAILY_REQUEST_CAP="200"
AI_TIMEOUT_MS="15000"

# [SERVER-ONLY] Konfigurasi Telegram Bot API R1
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""

